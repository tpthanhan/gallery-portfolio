{
  "semi": true,
  "singleQuote": false,
  "tabWidth": 2,
  "trailingComma": "all",
  "printWidth": 80,
  "plugins": [
    "@ianvs/prettier-plugin-sort-imports",
    "prettier-plugin-tailwindcss"
  ],
  "importOrder": [
    "^react$",
    "^react/",
    "^next(/.*)?$",
    "<BUILTIN_MODULES>",
    "<THIRD_PARTY_MODULES>",
    "",
    "^@/stores(/.*)?$",
    "^@/hooks(/.*)?$",
    "^@/constants(/.*)?$",
    "^@/utils(/.*)?$",
    "^@/components(/.*)?$",
    "^@/",
    "",
    "^[.]"
  ],
  "importOrderTypeScriptVersion": "5.0.0",
  "tailwindStylesheet": "./app/globals.css",
  "tailwindFunctions": ["cn", "clsx", "cva"]
}

# Copy to .env.local. Restart the development server after editing.
# All settings are SERVER-ONLY. Never prefix credentials with NEXT_PUBLIC_.

# true (default): curated Unsplash samples; NO Google Drive requests or credentials.
# false: your private Google Drive folder; requires every GOOGLE_* / signing setting below.
GALLERY_DEMO_MODE=true
GALLERY_PHOTOGRAPHER="Alex Morgan"

# Enable the Google Drive API in your Google Cloud project, create a service account,
# create a JSON key, and share ONLY the portfolio folder with its client_email as Viewer.
# Keep the folder private; no "anyone with the link" sharing is needed.
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste private_key from the JSON. Keep the surrounding quotes and escaped \n newlines.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=""

# At least 32 random characters. Generate a strong value with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Changing this secret invalidates existing image links.
GALLERY_SIGNING_SECRET=
